# Supabase: Project Settings > Database > Connection string.
# DATABASE_URL = Transaction pooler (porta 6543), usada pela aplicação.
DATABASE_URL="postgresql://postgres.SEU_REF:SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL = conexão direta ou Session pooler (porta 5432), usada por migrate, seed e testes.
DIRECT_URL="postgresql://postgres.SEU_REF:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres"

# Supabase Auth: Project Settings > API (URL e chave publishable).
NEXT_PUBLIC_SUPABASE_URL="https://SEU_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."
# E-mails que podem entrar (separados por vírgula). Vazio = ninguém entra.
AUTH_EMAILS_PERMITIDOS="gestor@sualoja.com"
